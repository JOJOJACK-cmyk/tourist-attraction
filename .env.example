# IntelliJ Run Configuration 환경변수 또는 PowerShell $env: 설정으로 적용
# Spring Boot는 이 파일을 자동으로 읽지 않습니다.
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_URL=jdbc:mysql://localhost:3306/tourist_attraction?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 선택: 최초 관리자 생성용. 기존 회원 아이디와 겹치지 않게 설정
APP_ADMIN_LOGIN=
APP_ADMIN_PASSWORD=
# 선택: 사진을 보관할 서버 폴더
APP_UPLOAD_DIR=./uploads/community
